    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@9.15.4",
