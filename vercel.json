{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/market/:path*",
      "destination": "https://app.plabs.online/dex-matcher/:path*"
    },
    {
      "source": "/api/monad/:path*",
      "destination": "https://monad-indexer.plabs.online/:path*"
    },
    {
      "source": "/api/ethereum/:path*",
      "destination": "https://eth-indexer.plabs.online/:path*"
    },
    {
      "source": "/api/platform/:path*",
      "destination": "https://api.plabs.online/:path*"
    },
    {
      "source": "/api/jubjub/config",
      "destination": "/api/jubjub-proxy?route=config"
    },
    {
      "source": "/api/jubjub/summary",
      "destination": "/api/jubjub-proxy?route=summary"
    },
    {
      "source": "/api/jubjub/history",
      "destination": "/api/jubjub-proxy?route=history"
    },
    {
      "source": "/api/jubjub/me",
      "destination": "/api/jubjub-proxy?route=me"
    },
    {
      "source": "/api/jubjub/auth/challenge",
      "destination": "/api/jubjub-proxy?route=auth/challenge"
    },
    {
      "source": "/api/jubjub/auth/session",
      "destination": "/api/jubjub-proxy?route=auth/session"
    },
    {
      "source": "/api/jubjub/bids/prepare",
      "destination": "/api/jubjub-proxy?route=bids/prepare"
    },
    {
      "source": "/api/jubjub/refund",
      "destination": "/api/jubjub-proxy?route=refund"
    },
    {
      "source": "/api/nft/pool/:pool",
      "destination": "/api/nft-proxy?route=pool/:pool"
    },
    {
      "source": "/api/nft/whitelist/check",
      "destination": "/api/nft-proxy?route=whitelist/check"
    },
    {
      "source": "/api/nft-media/collections/:hash/manifest.json",
      "destination": "https://media.plabs.online/collections/:hash/manifest.json"
    },
    {
      "source": "/api/nft-media/objects/:hash.webp",
      "destination": "https://media.plabs.online/objects/:hash.webp"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/assets/",
      "destination": "/index.html"
    }
  ]
}
